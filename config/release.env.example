# Copy this file to config/release.local.env and fill local release settings.
# config/release.local.env is intentionally ignored by git.

# App identity
BUNDLE_ID="com.example.meeting-rescue"
# Omit APP_VERSION to use VERSION.
# APP_VERSION="0.1.0"
# Omit BUILD_NUMBER to use `git rev-list --count HEAD`.
# BUILD_NUMBER="1"
APP_COPYRIGHT="Copyright © Example Organization. All rights reserved."

# Sparkle update feed. The public EdDSA key is safe to keep in git.
SPARKLE_FEED_URL="https://example.github.io/meeting-rescue/appcast.xml"
SPARKLE_PUBLIC_ED_KEY="YOUR_SPARKLE_PUBLIC_ED_KEY"

# Google Calendar OAuth
# scripts/build_app.sh automatically uses private/GoogleCalendarOAuthConfig.json if it exists.
# Override this only when the local OAuth client JSON lives somewhere else.
# GOOGLE_CALENDAR_OAUTH_CONFIG_FILE="/absolute/path/to/client_secret_*.json"

# Developer ID signing
# Leave SIGN_IDENTITY empty to use local ad-hoc signing.
TEAM_ID="YOUR_TEAM_ID"
SIGN_IDENTITY="Developer ID Application: Example Organization (YOUR_TEAM_ID)"

# Optional entitlements file path, if the app later needs one.
# CODESIGN_ENTITLEMENTS=""

# Notarization scripts should use this Keychain profile name.
# Create it with:
# xcrun notarytool store-credentials "meeting-rescue-notary" \
#   --apple-id "YOUR_APPLE_ID@example.com" \
#   --team-id "$TEAM_ID" \
#   --password "YOUR_NOTARY_PASSWORD"
NOTARY_KEYCHAIN_PROFILE="meeting-rescue-notary"
