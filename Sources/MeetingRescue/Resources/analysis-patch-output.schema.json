{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["meetingType", "meetingSummary", "currentIssue", "topicTimelineUpserts", "closeTopicIDs", "decisionCandidateUpserts", "actionItemCandidateUpserts", "risksOrNotesAppend"],
  "properties": {
    "meetingType": {
      "anyOf": [
        { "enum": ["decision", "planning", "incident", "oneOnOne", "brainstorm", "status"] },
        { "type": "null" }
      ]
    },
    "meetingSummary": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["overview", "keyPoints", "openQuestions"],
          "properties": {
            "overview": { "type": "string", "maxLength": 500 },
            "keyPoints": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text", "evidence"],
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string", "maxLength": 260 },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["timestamp", "speaker", "excerpt"],
                      "properties": {
                        "timestamp": { "type": "string" },
                        "speaker": { "type": ["string", "null"] },
                        "excerpt": { "type": "string", "maxLength": 220 }
                      }
                    }
                  }
                }
              }
            },
            "openQuestions": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "text", "evidence"],
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string", "maxLength": 220 },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["timestamp", "speaker", "excerpt"],
                      "properties": {
                        "timestamp": { "type": "string" },
                        "speaker": { "type": ["string", "null"] },
                        "excerpt": { "type": "string", "maxLength": 220 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "currentIssue": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "openQuestions"],
          "properties": {
            "summary": { "type": "string", "maxLength": 360 },
            "openQuestions": {
              "type": "array",
              "maxItems": 3,
              "items": { "type": "string", "maxLength": 180 }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "topicTimelineUpserts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startTimestamp", "endTimestamp", "title", "summary"],
        "properties": {
          "id": { "type": "string" },
          "startTimestamp": { "type": "string" },
          "endTimestamp": { "type": ["string", "null"] },
          "title": { "type": "string", "maxLength": 100 },
          "summary": { "type": "string", "maxLength": 260 }
        }
      }
    },
    "closeTopicIDs": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "decisionCandidateUpserts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status", "evidenceTimestamp", "speaker"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "maxLength": 240 },
          "status": { "enum": ["candidate", "confirmed", "deleted"] },
          "evidenceTimestamp": { "type": "string" },
          "speaker": { "type": ["string", "null"] }
        }
      }
    },
    "actionItemCandidateUpserts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assignee", "task", "deadline", "status", "evidenceTimestamp", "speaker"],
        "properties": {
          "id": { "type": "string" },
          "assignee": { "type": ["string", "null"] },
          "task": { "type": "string", "maxLength": 240 },
          "deadline": { "type": ["string", "null"] },
          "status": { "enum": ["candidate", "confirmed", "deleted"] },
          "evidenceTimestamp": { "type": "string" },
          "speaker": { "type": ["string", "null"] }
        }
      }
    },
    "risksOrNotesAppend": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 240 }
    }
  }
}
